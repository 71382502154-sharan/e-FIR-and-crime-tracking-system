const fs = require('fs');
let file = fs.readFileSync('src/components/AnalyticsDashboard.tsx', 'utf8');

// Imports
file = file.replace(
  "import { MapContainer, TileLayer, CircleMarker, Popup } from 'react-leaflet';",
  "import { MapContainer, TileLayer, CircleMarker, Popup, useMapEvents } from 'react-leaflet';"
);

// MapEvents Component
const mapEventsCode = `
const MapEventsComponent = ({ isAdding, onAdd }: { isAdding: boolean, onAdd: (latlng: any) => void }) => {
  useMapEvents({
    click(e) {
      if (isAdding) {
        onAdd(e.latlng);
      }
    }
  });
  return null;
};
`;
file = file.replace("// Network Graph Component", mapEventsCode + "\n// Network Graph Component");

// Icons
file = file.replace(
  "Map as MapIcon, Share2, BarChart3, ShieldAlert, Loader2 } from 'lucide-react';",
  "Map as MapIcon, Share2, BarChart3, ShieldAlert, Loader2, Plus, Edit } from 'lucide-react';"
);

// State for adding mode
file = file.replace(
  "const [hotspots, setHotspots] = useState<any[]>([]);",
  "const [hotspots, setHotspots] = useState<any[]>([]);\n  const [isAddingGeo, setIsAddingGeo] = useState(false);\n  const [isEditingGraph, setIsEditingGraph] = useState(false);\n"
);

// Adding geo handler
const handleAddGeoCode = `
  const handleMapClick = (latlng: any) => {
    if (!isAddingGeo) return;
    const newPoint = {
      id: Date.now(),
      lat: latlng.lat,
      lng: latlng.lng,
      type: 'New Report',
      risk: 'Medium',
      date: new Date().toISOString().split('T')[0]
    };
    setGeoData([...geoData, newPoint]);
    setIsAddingGeo(false);
  };
`;
file = file.replace("useEffect(() => {", handleAddGeoCode + "\n  useEffect(() => {");

// Add button to geo map
file = file.replace(
  '<span className="flex items-center gap-1 text-xs font-semibold text-slate-600"><div className="w-2 h-2 rounded-full bg-amber-500"></div> Medium</span>',
  '<span className="flex items-center gap-1 text-xs font-semibold text-slate-600"><div className="w-2 h-2 rounded-full bg-amber-500"></div> Medium</span>\n                    <button onClick={() => setIsAddingGeo(!isAddingGeo)} className={`ml-4 px-3 py-1 rounded text-xs font-bold flex items-center gap-1 transition-colors ${isAddingGeo ? "bg-indigo-600 text-white" : "bg-indigo-50 text-indigo-700 hover:bg-indigo-100"}`}><Plus className="w-3 h-3" /> {isAddingGeo ? "Click Map to Add" : "Add Crime Area"}</button>'
);

// Add MapEventsComponent to map
file = file.replace(
  "className=\"map-tiles grayscale opacity-80\" // Styling for modern dashboard look\n                    />",
  "className=\"map-tiles grayscale opacity-80\" // Styling for modern dashboard look\n                    />\n                    <MapEventsComponent isAdding={isAddingGeo} onAdd={handleMapClick} />"
);

fs.writeFileSync('src/components/AnalyticsDashboard.tsx', file);
