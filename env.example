import React, { useState } from 'react';
import { useNavigate, Navigate } from 'react-router-dom';
import { Bell, UserCircle, LayoutDashboard, FolderOpen, HelpCircle, PlusCircle, ArrowRight, Search, Phone, Clock, ShieldCheck, CheckCircle2, Eye, Download, Megaphone } from 'lucide-react';
import { useAppStore } from '../store/appStore';
import { format } from 'date-fns';
import { cn } from '../lib/utils';
import { t } from '../lib/i18n';
import LanguageSelector from '../components/LanguageSelector';
import { generateFIRPdf } from '../lib/pdfGenerator';
import FIRDetailsModal from '../components/FIRDetailsModal';
import LegalLibraryModal from '../components/LegalLibraryModal';
import ProfileModal from '../components/ProfileModal';
import PoliceStationsModal from '../components/PoliceStationsModal';
import { Building2, Map as MapIcon } from 'lucide-react';
import AnalyticsDashboard from '../components/AnalyticsDashboard';
import { FIR } from '../types';

import NotificationsModal from '../components/NotificationsModal';

export default function CitizenDashboard() {
  const navigate = useNavigate();
  const { user, firs, logout, language, setLanguage } = useAppStore();
  const text = t[language];
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedFir, setSelectedFir] = useState<FIR | null>(null);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isLegalLibraryOpen, setIsLegalLibraryOpen] = useState(false);
  const [isProfileOpen, setIsProfileOpen] = useState(false);
  const [isNotificationsOpen, setIsNotificationsOpen] = useState(false);
  const [isPoliceStationsOpen, setIsPoliceStationsOpen] = useState(false);
  const [activeTab, setActiveTab] = useState<'home' | 'heatmap'>('home');

  const handleLogout = () => {
    logout();
    navigate('/');
  };

  const citizenFirs = firs.filter(fir => fir.userId === user?.id);
  
  const filteredFirs = citizenFirs.filter(f => 
    f.firNumber.toLowerCase().includes(searchQuery.toLowerCase()) || 
    f.title.toLowerCase().includes(searchQuery.toLowerCase())
  );

  return (
    <div className="min-h-screen flex flex-col md:flex-row bg-[#f9f9f9] text-[#1a1c1c] font-sans antialiased relative">
       {/* Background Image */}
       <div 
        className="fixed inset-0 bg-cover bg-center bg-fixed z-0"
        style={{ backgroundImage: 'url("https://lh3.googleusercontent.com/aida-public/AB6AXuCo1wZDMvOkynJpEwl1tdj7bSz7yOvs98ICJ9murFu0rCvkCTc5qyW3VRPpQkd4M2cmP8wCsIJJdQ01nF3pXlZqF4b0ye-VIuHzLhL1IqYLpr5DvGkmLNeKCPoItZm9OEXNr6125hgtYimKI6U-RiVC4IoMg79_zq57W2JRjbDqbTi3MeG1G1mdAmNMt23ZOEUh6330O0COynLS-V8MHJLviBIhyP-PcI7X6HfdTvKD2VOmwgYSfWeKJIbWwlW2qKP1GQ")'}}
      />

      {/* TopNavBar (Mobile Only) */}
      <header className="md:hidden glass-panel fixed top-0 w-full z-50 flex justify-between items-center px-4 h-16 bg-white/65 backdrop-blur-xl border-b border-white/40">
        <div className="flex items-center gap-2">
          <img src="/karnataka-logo.svg" alt="Logo" className="w-8 h-8 object-contain" />
          <div className="text-xl font-bold text-primary drop-shadow-sm font-display">{text['app.title']}</div>
        </div>
        <div className="flex items-center gap-4">
          <button className="text-primary" onClick={() => setIsNotificationsOpen(true)}><Bell className="w-6 h-6" /></button>
          <button className="text-primary" onClick={() => setIsProfileOpen(true)}><UserCircle className="w-6 h-6" /></button>
        </div>
      </header>

      {/* Main Content Area */}
      <main className="flex-1 md:ml-64 pt-20 md:pt-12 px-4 md:px-16 pb-24 md:pb-12 max-w-7xl w-full z-10 mx-auto">
        {activeTab === 'home' ? (
          <>
        {/* Welcome Banner */}
        <section className="relative z-50 mb-8">
          <div className="glass-panel rounded-2xl p-6 flex justify-between items-start md:items-center flex-col md:flex-row gap-4">
            <div>
              <h1 className="text-2xl md:text-3xl font-display font-bold text-primary mb-1 drop-shadow-sm">{text['citizen.welcome']}, {user?.name || 'Citizen'}</h1>
              <p className="text-base text-on-surface-variant font-medium">{text['citizen.subtitle']}</p>
            </div>
            <LanguageSelector variant="outline" />
          </div>
        </section>

        {/* Quick Actions */}
        <section className="glass-panel rounded-2xl p-3 mb-10 flex flex-col lg:flex-row gap-3">
          {/* File FIR */}
          <button 
            onClick={() => navigate('/file-fir')}
            className="flex-1 bg-gradient-to-br from-primary to-[#4c56af] text-white rounded-xl py-3 px-6 flex items-center justify-between group hover:shadow-lg transition-all"
          >
            <div className="flex items-center gap-3">
              <span className="bg-white/20 p-2 rounded-lg"><PlusCircle className="w-5 h-5" /></span>
              <span className="text-sm font-bold">{text['citizen.fileFir']}</span>
            </div>
            <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
          </button>
          
          {/* Track Status Search */}
          <div className="flex-1 relative group">
            <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-on-surface-variant">
              <Search className="w-5 h-5" />
            </div>
            <input 
              className="w-full bg-white/60 border border-white/50 rounded-xl py-4 pl-12 pr-12 text-base focus:outline-none focus:bg-white focus:ring-2 focus:ring-primary/30 placeholder:text-on-surface-variant/70 shadow-inner transition-all" 
              placeholder={text['citizen.trackStatus']}
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
            />
            <button className="absolute right-2 top-2 bottom-2 bg-primary/10 text-primary px-3 rounded-lg hover:bg-primary/20 transition-colors flex items-center justify-center">
              <ArrowRight className="w-5 h-5" />
            </button>
          </div>
          
          {/* Emergency */}
          <button onClick={() => window.open('tel:112')} className="lg:w-auto bg-gradient-to-br from-error to-[#ff6b6b] text-white rounded-xl py-3 px-6 flex items-center justify-center gap-2 hover:shadow-lg transition-all">
            <Phone className="w-5 h-5" />
            <span className="text-sm font-bold">{text['citizen.dial112']}</span>
          </button>
        </section>

        {/* Main Grid */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
          {/* Recent Complaints */}
          <div className="lg:col-span-2">
            <div className="flex justify-between items-center mb-6 px-2">
              <h2 className="text-xl font-display text-on-surface font-bold drop-shadow-sm">{text['citizen.recent']}</h2>
              <button className="text-sm text-primary bg-white/50 px-4 py-1.5 rounded-full hover:bg-white/80 transition-colors flex items-center gap-1 border border-white/40 shadow-sm font-semibold">
                {text['citizen.viewAll']} <ArrowRight className="w-4 h-4 ml-1" />
              </button>
            </div>
            
            <div className="flex flex-col gap-4">
              {filteredFirs.length === 0 && (
                <div className="glass-panel p-8 rounded-2xl flex flex-col items-center justify-center text-center text-on-surface-variant">
                  <FolderOpen className="w-12 h-12 mb-4 opacity-50" />
                  <h3 className="text-lg font-bold text-on-surface">No Complaints Found</h3>
                  <p className="text-sm">You haven't filed any complaints yet, or none match your search.</p>
                </div>
              )}
              {filteredFirs.map((fir) => {
                const getStatusStyles = (status: string) => {
                  switch (status) {
                    case 'Pending Verification':
                      return {
                        cardBorder: "border-l-secondary",
                        iconBg: "bg-secondary-container/80",
                        iconText: "text-secondary",
                        badgeBg: "bg-secondary-container text-on-secondary-container",
                        Icon: Clock
                      };
                    case 'Pending Assignment':
                      return {
                        cardBorder: "border-l-orange-400",
                        iconBg: "bg-orange-100 border border-orange-200",
                        iconText: "text-orange-600",
                        badgeBg: "bg-orange-100 text-orange-700 border border-orange-200",
                        Icon: UserCircle
                      };
                    case 'Under Investigation':
                      return {
                        cardBorder: "border-l-blue-400",
                        iconBg: "bg-blue-100 border border-blue-200",
                        iconText: "text-blue-600",
                        badgeBg: "bg-blue-100 text-blue-700 border border-blue-200",
                        Icon: Search
                      };
                    case 'Verified & Active':
                      return {
                        cardBorder: "border-l-primary",
                        iconBg: "bg-primary-container/20",
                        iconText: "text-primary",
                        badgeBg: "bg-primary-fixed text-on-primary-fixed",
                        Icon: ShieldCheck
                      };
                    case 'Closed':
                      return {
                        cardBorder: "border-l-outline opacity-80",
                        iconBg: "bg-white/50 border border-white/30",
                        iconText: "text-on-surface-variant",
                        badgeBg: "bg-white/70 text-on-surface-variant border border-white/30",
                        Icon: CheckCircle2
                      };
                    default:
                      return {
                        cardBorder: "border-l-primary",
                        iconBg: "bg-primary-container/20",
                        iconText: "text-primary",
                        badgeBg: "bg-primary-fixed text-on-primary-fixed",
                        Icon: ShieldCheck
                      };
                  }
                };
                
                const styles = getStatusStyles(fir.status);
                const Icon = styles.Icon;

                return (
                <div key={fir.id} className={cn(
                  "glass-panel hover-lift rounded-2xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4 border-l-4",
                  styles.cardBorder
                )}>
                  <div className="flex gap-4 items-start md:items-center">
                    <div className={cn(
                      "p-3 rounded-xl hidden md:block shadow-sm flex items-center justify-center",
                      styles.iconBg
                    )}>
                      <Icon className={cn("w-6 h-6", styles.iconText)} />
                    </div>
                    <div>
                      <div className="flex items-center gap-2 mb-1.5">
                        <span className={cn(
                          "text-xs px-2.5 py-1 rounded-md font-bold shadow-sm",
                          styles.badgeBg
                        )}>
                          {fir.status}
                        </span>
                        <span className="text-xs text-on-surface-variant font-medium bg-white/50 px-2.5 py-1 rounded-md border border-white/30">{fir.firNumber}</span>
                      </div>
                      <h4 className="text-lg font-display text-on-surface font-semibold">{fir.title}</h4>
                      <p className="text-sm text-on-surface-variant mt-1 font-medium">
                        {text['citizen.submittedOn']} {format(new Date(fir.dateFiled), 'dd MMM yyyy, HH:mm')} at {fir.station}
                      </p>
                    </div>
                  </div>
                  <div className="flex md:flex-col gap-2 mt-2 md:mt-0">
                    {fir.status === 'Closed' ? (
                      <button 
                        onClick={() => generateFIRPdf(fir, user)}
                        className="flex-1 md:flex-none py-2 px-4 bg-white/40 border border-white/50 rounded-xl text-on-surface-variant text-sm font-semibold hover:bg-white/70 shadow-sm flex items-center justify-center gap-1.5 transition-colors"
                      >
                        <Download className="w-4 h-4" /> Copy PDF
                      </button>
                    ) : fir.status === 'Pending Verification' ? (
                      <button 
                        onClick={() => {
                          setSelectedFir(fir);
                          setIsModalOpen(true);
                        }}
                        className="flex-1 md:flex-none py-2 px-4 bg-white/60 border border-white rounded-xl text-on-surface-variant text-sm font-semibold hover:bg-white shadow-sm flex items-center justify-center gap-1.5 transition-colors"
                      >
                        <Eye className="w-4 h-4" /> View Details
                      </button>
                    ) : (
                      <button 
                        onClick={() => generateFIRPdf(fir, user)}
                        className="flex-1 md:flex-none py-2 px-4 bg-white/60 border border-white rounded-xl text-primary text-sm font-semibold hover:bg-white shadow-sm flex items-center justify-center gap-1.5 transition-colors"
                      >
                        <Download className="w-4 h-4" /> Download PDF
                      </button>
                    )}
                  </div>
                </div>
              )})}
            </div>
          </div>

          {/* Sidebar Advisories */}
          <div className="lg:col-span-1">
            <div className="glass-panel rounded-2xl p-6 h-full flex flex-col">
              <div className="flex items-center gap-3 mb-6">
                <div className="bg-secondary-container/50 p-2 rounded-lg">
                  <Megaphone className="w-5 h-5 text-secondary" />
                </div>
                <h2 className="text-xl font-display text-on-surface font-bold">{text['citizen.advisories']}</h2>
              </div>
              
              <div className="flex flex-col gap-4">
                <div className="p-4 bg-white/60 rounded-xl border border-white/70 shadow-sm relative overflow-hidden hover-lift">
                  <div className="absolute left-0 top-0 bottom-0 w-1.5 bg-secondary"></div>
                  <h4 className="text-sm font-bold text-on-surface mb-1">Cyber Fraud Alert</h4>
                  <p className="text-sm text-on-surface-variant mb-3 font-medium">Beware of fake electricity bill payment messages asking to download APK files.</p>
                  <button onClick={() => setIsLegalLibraryOpen(true)} className="inline-block text-xs text-primary bg-primary/10 px-3 py-1 rounded-md hover:bg-primary/20 transition-colors font-bold">Read Guidelines</button>
                </div>
                

              </div>

              <div className="mt-auto pt-8 text-center pb-2">
                <div className="inline-block p-3 bg-white/50 rounded-2xl border border-white/60 shadow-sm mb-3">
                  {/* Emblem placeholder */}
                  <div className="w-14 h-14 bg-gradient-to-br from-primary to-[#00b4d8] rounded-full mx-auto flex items-center justify-center">
                    <ShieldCheck className="w-8 h-8 text-white" />
                  </div>
                </div>
                <p className="text-xs text-on-surface-variant font-bold">
                  {text['app.title']}<br/>
                  <span className="font-medium opacity-80">Commitment to Citizen Safety</span>
                </p>
              </div>
            </div>
          </div>
        </div>
          </>
        ) : (
          <div className="mt-4">
            <AnalyticsDashboard readOnly={true} />
          </div>
        )}
      </main>

      {/* SideNavBar (Desktop) */}
      <nav className="hidden md:flex flex-col h-screen w-64 fixed left-0 top-0 glass-panel border-r border-white/40 py-2 gap-2 z-40 !shadow-[10px_0_30px_-15px_rgba(0,0,0,0.1)]">
        <div className="px-6 py-4 border-b border-white/30 mb-4 flex flex-col items-center text-center">
          <img src="/karnataka-logo.svg" alt="Karnataka Logo" className="w-16 h-16 object-contain mb-3 drop-shadow-md" />
          <div className="text-xl font-display font-bold text-primary mb-1 drop-shadow-sm">Citizen Portal</div>
          <div className="flex items-center gap-3 mt-4 cursor-pointer" onClick={() => setIsProfileOpen(true)}>
            <div className="w-10 h-10 rounded-full border-2 border-white shadow-sm bg-primary/20 flex items-center justify-center">
               <UserCircle className="w-6 h-6 text-primary" />
            </div>
            <div className="text-left">
              <div className="text-sm text-on-surface font-bold">{user?.name || 'Citizen'}</div>
              <div className="text-xs text-on-surface-variant font-medium cursor-pointer hover:underline" onClick={(e) => { e.stopPropagation(); handleLogout(); }}>Log Out</div>
            </div>
          </div>
        </div>

        <div className="flex-1 px-4 flex flex-col gap-1">
          <button 
            onClick={() => setActiveTab('home')}
            className={`flex items-center gap-3 px-4 py-3 font-bold rounded-xl shadow-sm border text-sm ${activeTab === 'home' ? 'bg-white/50 text-primary border-white/40' : 'text-on-surface-variant border-transparent hover:bg-white/40 hover:translate-x-1 transition-all duration-200'}`}>
            <LayoutDashboard className={`w-5 h-5 ${activeTab === 'home' ? 'fill-primary/20' : ''}`} /> {text['nav.home']}
          </button>
          <button 
            onClick={() => setActiveTab('heatmap')}
            className={`flex items-center gap-3 px-4 py-3 font-bold rounded-xl shadow-sm border text-sm ${activeTab === 'heatmap' ? 'bg-white/50 text-primary border-white/40' : 'text-on-surface-variant border-transparent hover:bg-white/40 hover:translate-x-1 transition-all duration-200'}`}>
            <MapIcon className={`w-5 h-5 ${activeTab === 'heatmap' ? 'fill-primary/20' : ''}`} /> Heatmap
          </button>
          <button 
            onClick={() => setIsPoliceStationsOpen(true)}
            className="w-full flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-white/40 hover:translate-x-1 transition-all duration-200 rounded-xl text-sm font-semibold"
          >
            <Building2 className="w-5 h-5" /> Police Stations
          </button>
          <button 
            onClick={() => setIsLegalLibraryOpen(true)}
            className="w-full flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-white/40 hover:translate-x-1 transition-all duration-200 rounded-xl text-sm font-semibold"
          >
            <HelpCircle className="w-5 h-5" /> {text['nav.help']}
          </button>
        </div>

        <div className="px-4 mt-auto mb-4">
          <button 
            onClick={() => navigate('/file-fir')}
            className="w-full bg-gradient-to-br from-primary to-[#4c56af] text-white text-sm font-bold py-3 rounded-xl flex justify-center items-center gap-2 hover:shadow-lg transition-all transform hover:-translate-y-0.5"
          >
            <PlusCircle className="w-5 h-5" /> {text['nav.fileFir']}
          </button>
        </div>
      </nav>

      {/* BottomNavBar (Mobile) */}
      <nav className="md:hidden fixed bottom-0 w-full glass-panel z-50 flex justify-around items-center h-16 pb-safe border-t border-white/40 bg-white/65">
        <button onClick={() => setActiveTab('home')} className={`flex flex-col items-center ${activeTab === 'home' ? 'text-primary font-bold' : 'text-on-surface-variant'}`}>
          <LayoutDashboard className={`w-6 h-6 ${activeTab === 'home' ? 'fill-primary/20' : ''}`} />
          <span className="text-[10px] mt-1 font-semibold">{text['nav.home']}</span>
        </button>
        <button onClick={() => setActiveTab('heatmap')} className={`flex flex-col items-center ${activeTab === 'heatmap' ? 'text-primary font-bold' : 'text-on-surface-variant'}`}>
          <MapIcon className={`w-6 h-6 ${activeTab === 'heatmap' ? 'fill-primary/20' : ''}`} />
          <span className="text-[10px] mt-1 font-semibold">Heatmap</span>
        </button>
        <button 
          onClick={() => setIsPoliceStationsOpen(true)}
          className="flex flex-col items-center text-on-surface-variant"
        >
          <Building2 className="w-6 h-6" />
          <span className="text-[10px] mt-1 font-semibold">Stations</span>
        </button>
        <button 
          onClick={() => setIsLegalLibraryOpen(true)}
          className="flex flex-col items-center text-on-surface-variant"
        >
          <HelpCircle className="w-6 h-6" />
          <span className="text-[10px] mt-1 font-semibold">{text['nav.help']}</span>
        </button>
      </nav>

      <FIRDetailsModal 
        isOpen={isModalOpen}
        onClose={() => setIsModalOpen(false)}
        fir={selectedFir}
        user={user}
      />
      <PoliceStationsModal 
        isOpen={isPoliceStationsOpen}
        onClose={() => setIsPoliceStationsOpen(false)}
      />
      
      <LegalLibraryModal
        isOpen={isLegalLibraryOpen}
        onClose={() => setIsLegalLibraryOpen(false)}
      />

      {isProfileOpen && <ProfileModal onClose={() => setIsProfileOpen(false)} />}
      <NotificationsModal isOpen={isNotificationsOpen} onClose={() => setIsNotificationsOpen(false)} />
    </div>
  );
}
