            {step === 2 && (
              <>
                <div className="flex flex-col gap-2">
                  <label className="text-sm font-bold text-slate-800 flex justify-between">
                    <span>Incident Location (Karnataka) <span className="text-red-500">*</span></span>
                  </label>
                  <p className="text-xs text-slate-500 mb-1">Click on the map to pin the exact location.</p>
                  
                  <div className="h-[300px] w-full rounded-xl overflow-hidden border border-slate-300 shadow-sm relative z-0">
                    <MapContainer 
                      center={[formData.locationLat, formData.locationLng]} 
                      zoom={7} 
                      minZoom={6}
                      maxBounds={[
                        [11.5, 74.0],
                        [18.5, 78.5]
                      ]}
                      maxBoundsViscosity={1.0}
                      scrollWheelZoom={false}
                      className="h-full w-full"
                    >
                      <TileLayer
                        attribution='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                        url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
                        noWrap={true}
                      />
                      <LocationMarker 
                        position={new L.LatLng(formData.locationLat, formData.locationLng)} 
