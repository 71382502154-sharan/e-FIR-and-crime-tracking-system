    crimeType: '',
    incidentDate: '',
    description: '',
    title: '',
    locationLat: 15.3173, // Default Karnataka center
    locationLng: 75.7139,
    address: '',
    incidentTime: '',
    evidenceFiles: [] as File[],
  });
  
