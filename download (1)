                        ))}
                      </div>
                    )}
                  </div>
                </div>

                <div className="bg-yellow-50 border border-yellow-200 rounded-xl p-4 flex gap-3">
                  <div className="mt-0.5">
                    <MapPin className="w-5 h-5 text-yellow-600" />
                  </div>
                  <div>
                    <h4 className="text-sm font-bold text-yellow-800">Declaration</h4>
                    <p className="text-xs font-medium text-yellow-700 mt-1">
                      By submitting this FIR, I declare that the information provided is true and correct to the best of my knowledge. I understand that false reporting is a punishable offense.
                    </p>
                  </div>
                </div>
              </div>
            )}
          </div>

          <div className="flex justify-end mt-2 pb-12">
            <button 
              onClick={handleNext}
              className="flex items-center gap-2 px-8 py-3 bg-gradient-to-br from-blue-600 to-cyan-500 text-white text-sm font-bold rounded-xl transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5"
            >
              {step === 1 ? text['fir.proceed'] : step === 4 ? 'Submit FIR' : 'Continue'}
              <ArrowRight className="w-5 h-5" />
            </button>
          </div>
        </section>

      </main>
      <LegalLibraryModal
        isOpen={isLegalLibraryOpen}
        onClose={() => setIsLegalLibraryOpen(false)}
      />
      {isProfileOpen && <ProfileModal onClose={() => setIsProfileOpen(false)} />}
      <NotificationsModal isOpen={isNotificationsOpen} onClose={() => setIsNotificationsOpen(false)} />
    </div>
  );
}
